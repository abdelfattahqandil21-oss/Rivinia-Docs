{
  "name": "rivinia-docs",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "prestart": "node scripts/generate-showcase-sources.mjs",
    "prebuild": "node scripts/generate-showcase-sources.mjs",
    "pretest": "node scripts/generate-showcase-sources.mjs",
    "verify:showcase-sources": "node scripts/generate-showcase-sources.mjs --check",
    "check:arch": "node scripts/check-architecture.mjs",
    "verify": "prettier --check AGENTS.md \"docs/**/*.md\" \".agents/skills/**/*.md\" \"scripts/**/*.mjs\" package.json \"public/i18n/*.json\" \"src/app/**/*.{ts,html,css}\" && npm run check:arch && node scripts/generate-showcase-sources.mjs --check && npm run build && npm test -- --watch=false --runner=vitest"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@lucide/angular": "^1.70.0",
    "@rivinia/datepicker": "^1.0.3",
    "@rivinia/env": "^1.0.3",
    "@rivinia/http": "^1.0.3",
    "@rivinia/i18n": "^1.0.3",
    "@rivinia/menu": "^1.0.3",
    "@rivinia/modal": "^1.0.3",
    "@rivinia/popup": "^1.0.3",
    "@rivinia/select": "^1.0.3",
    "@rivinia/table": "^1.0.3",
    "@rivinia/theme": "^1.0.3",
    "@rivinia/toast": "^1.0.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.0",
    "@tailwindcss/postcss": "^4.1.12",
    "jsdom": "^30.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
